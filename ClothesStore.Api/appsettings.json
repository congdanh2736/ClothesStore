{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ClothesStoreDb;TrustServerCertificate=true;Integrated Security=true;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "ClothesStore-Super-Secret-Key-Minimum-32-Characters-Long-2026",
    "Issuer": "ClothesStoreApi",
    "Audience": "ClothesStoreClient",
    "ExpiresInMinutes": 60
  }
}
